            "mimeType": "application/json",
            "text": "{\"message\":\"Success Get Notif Setting\", \"data\":[{\"group\":\"NOTIF_GROUP_SOCIAL\", \"label\":\"Social\", \"notifications\":[{\"type\":\"NOTIF_TYPE_MENTIONS\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_EM\", \"value\":true}], \"label\":\"Mentions\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_STREAM_REACTION\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Reactions\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_REPLY\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Replies\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_FOLLOWING\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Followed\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_RETWEET\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Reposts\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_POSTALERT\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Followed users post\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_NEWUSERJOIN\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Friend on Stockbit\", \"info\":\"John, one of your contacts, is on stockbit as @johndoe. Would you like to follow?\"}]}, {\"group\":\"NOTIF_GROUP_CHAT\", \"label\":\"Chat\", \"notifications\":[{\"type\":\"NOTIF_TYPE_INBOX\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Personal Chat\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_GROUPCHAT\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Group Chat\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_MESSAGE_REQUEST\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Message Request\", \"info\":\"\"}]}, {\"group\":\"NOTIF_GROUP_TIPPING\", \"label\":\"Tipping\", \"notifications\":[{\"type\":\"NOTIF_TYPE_TIPPING_RECEIVER\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Tipping Received\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_TIPPING_SENDER\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Tipping Sent\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_CLAIM\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Tipping Claimed\", \"info\":\"\"}]}, {\"group\":\"NOTIF_GROUP_COMPANY_ANNOUNCEMENT\", \"label\":\"Company Announcement\", \"notifications\":[{\"type\":\"NOTIF_TYPE_NEW_REPORT\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_EM\", \"value\":true}], \"label\":\"Financial Statement\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_COMPANY_PUBLIC_EXPOSE\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":false}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":false}], \"label\":\"RUPS/Public Expose\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_COMPANY_SHAREHOLDING\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":false}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":false}], \"label\":\"Shareholding\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_COMPANY_DIVIDEND\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":false}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":false}], \"label\":\"Dividend\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_COMPANY_CORP_ACTION\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":false}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":false}], \"label\":\"Corporate Action\", \"info\":\"\"}, {\"type\":\"NOTIF_TYPE_COMPANY_OTHERS\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":false}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":false}], \"label\":\"Others\", \"info\":\"\"}]}, {\"group\":\"NOTIF_GROUP_UNSPECIFIED\", \"label\":\"Other notifications\", \"notifications\":[{\"type\":\"NOTIF_TYPE_NEWSFEED\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Company News\", \"info\":\"News: Kontrak baru WSKT capai 72%\"}, {\"type\":\"NOTIF_TYPE_STOCK_ALERT\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Price Alert\", \"info\":\"WSBP has hit your target price of <= 480\"}, {\"type\":\"NOTIF_TYPE_NEW_TRENDING\", \"settings\":[{\"key\":\"NOTIF_SETTING_KEY_DN\", \"value\":true}, {\"key\":\"NOTIF_SETTING_KEY_PN\", \"value\":true}], \"label\":\"Trending Stocks\", \"info\":\"Your watchlist item BBCA is trending\"}]}]}"
